<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kartu Ulang Tahun Islami</title>

<style>
body{
margin:0;
height:100vh;
display:flex;
justify-content:center;
align-items:center;
background:linear-gradient(135deg,#11998e,#38ef7d);
font-family:Arial;
overflow:hidden;
color:#333;
}

.card{
width:340px;
height:220px;
background:white;
border-radius:20px;
box-shadow:0 20px 40px rgba(0,0,0,0.3);
display:flex;
justify-content:center;
align-items:center;
cursor:pointer;
position:relative;
animation:float 3s infinite ease-in-out;
text-align:center;
padding:15px;
transition:0.5s;
}

@keyframes float{
0%{transform:translateY(0);}
50%{transform:translateY(-15px);}
100%{transform:translateY(0);}
}

.hidden{
display:none;
flex-direction:column;
}

button{
margin-top:10px;
padding:8px 12px;
border:none;
border-radius:10px;
background:#11998e;
color:white;
cursor:pointer;
}

</style>
</head>
<body>

<div class="card" onclick="buka()" id="card">
<div id="awal">
<h3>Klik Untuk Buka 🎉</h3>
</div>

<div class="hidden" id="isi">
<h3>Barakallahu Fii Umrik 🎂</h3>
<p>
Semoga Allah panjangkan umurmu dalam kebaikan,  
melimpahkan kesehatan, keberkahan rezeki,  
dan menjadikanmu pribadi yang semakin taat  
serta bermanfaat dunia akhirat. Aamiin.
</p>

<button onclick="suara(event)">Putar Doa 🤲</button>
</div>
</div>

<script>
function buka(){
document.getElementById("awal").style.display="none";
document.getElementById("isi").style.display="flex";
}

function suara(e){
e.stopPropagation();
let text="Barakallahu fii umrik. Semoga Allah melimpahkan keberkahan, kesehatan, dan kebahagiaan untukmu.";
let speech=new SpeechSynthesisUtterance(text);
speech.lang="id-ID";
window.speechSynthesis.speak(speech);
}
</script>

</body>
</html>
