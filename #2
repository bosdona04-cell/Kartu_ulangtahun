<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kartu Ulang Tahun</title>
<style>
body{
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg,#4e73df,#1cc88a);
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
    margin:0;
}
.card{
    background:white;
    width:350px;
    padding:20px;
    border-radius:15px;
    text-align:center;
    box-shadow:0 10px 30px rgba(0,0,0,0.2);
}
h1{
    color:#ff4b5c;
}
button{
    margin-top:15px;
    padding:10px 20px;
    border:none;
    border-radius:8px;
    background:#4e73df;
    color:white;
    font-size:16px;
    cursor:pointer;
}
button:hover{
    background:#2e59d9;
}
.popup{
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.5);
    justify-content:center;
    align-items:center;
}
.popup-content{
    background:white;
    padding:20px;
    border-radius:10px;
    text-align:center;
}
.error{
    color:red;
    font-weight:bold;
}
</style>
</head>
<body>

<div class="card">
    <h1>Happy Birthday!</h1>
    <p>Selamat Ulang Tahun, Kakak!</p>
    <p>Semoga hari spesialmu penuh kebahagiaan dan impianmu menjadi kenyataan 🎉</p>
    <button onclick="buatKartu()">Buat Kartu</button>
</div>

<div class="popup" id="popup">
    <div class="popup-content">
        <p class="error">Gagal Membuat Kartu Ucapan!</p>
        <p>Terjadi kesalahan saat membuat kartu. Silakan coba lagi.</p>
        <button onclick="tutup()">Coba Lagi</button>
    </div>
</div>

<script>
function buatKartu(){
    let random = Math.random();
    if(random < 0.5){
        document.getElementById("popup").style.display="flex";
    } else {
        alert("Kartu berhasil dibuat 🎉");
    }
}

function tutup(){
    document.getElementById("popup").style.display="none";
}
</script>

</body>
</html>
